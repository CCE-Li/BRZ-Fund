{
  "name": "brz-fund",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BRZ Fund — 以购车目标为中心的个人财务管理应用（本地优先 / IndexedDB）",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
